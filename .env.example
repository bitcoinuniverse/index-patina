# PATINA indexer configuration.
# Copy to .env and edit. Every value below is the built in default unless the
# comment says otherwise. The process refuses to start on an invalid value.

# ---------------------------------------------------------------- network

# regtest, signet or mainnet.
PATINA_NETWORK=regtest

# Mainnet is fail closed. It needs this set to true AND a deployment record
# that names at least two approvers. Leave it alone until an activation
# authorization exists.
PATINA_MAINNET_AUTHORIZED=false

# Path to a reviewed deployment record. Required for mainnet. When unset on
# regtest or signet the record shipped with @bitcoinuniverse/patina is used.
# PATINA_DEPLOYMENT_FILE=/etc/patina/deployment.mainnet.json

# Build a deployment from a chosen window opening height instead of a file.
# Test networks only, and both values are required together.
# PATINA_H_OPEN=200
# PATINA_SPEC_SHA256=

# ------------------------------------------------------------ bitcoin core

# Core needs -txindex=1. The resolver looks up historical transactions to find
# the creation height of every input it spends.
PATINA_BITCOIN_RPC_URL=http://127.0.0.1:18443
PATINA_BITCOIN_RPC_USER=
PATINA_BITCOIN_RPC_PASSWORD=
# Use the cookie file instead of a username and password if you prefer.
# PATINA_BITCOIN_RPC_COOKIE_FILE=/home/bitcoin/.bitcoin/regtest/.cookie
PATINA_BITCOIN_RPC_TIMEOUT_MS=30000
PATINA_BITCOIN_RPC_MAX_RETRIES=3

# Serve an already indexed database with no node attached. Sync does nothing
# in this mode.
PATINA_RPC_OFFLINE=false

# ------------------------------------------------------------------ storage

PATINA_DATA_DIR=./data
# Defaults to <data dir>/patina-<network>.sqlite. Use :memory: for a throwaway.
# PATINA_DB_PATH=./data/patina-regtest.sqlite

# ------------------------------------------------------------------ indexer

# First height to index. Defaults to the window opening height minus the
# minimum commit age, which is the earliest block that can matter.
# PATINA_START_HEIGHT=56
PATINA_POLL_INTERVAL_MS=3000
PATINA_CHECKPOINT_INTERVAL=2016
PATINA_UNDO_RETENTION_BLOCKS=2016
# A reorg deeper than this stops the process rather than rolling back blindly.
PATINA_MAX_REORG_DEPTH=200
PATINA_MEMPOOL_ENABLED=true
PATINA_MEMPOOL_POLL_INTERVAL_MS=5000

# ---------------------------------------------------------------------- api

PATINA_API_HOST=127.0.0.1
PATINA_API_PORT=4180
PATINA_API_BASE_PATH=/patina
PATINA_API_DEFAULT_LIMIT=50
PATINA_API_MAX_LIMIT=200
PATINA_API_RATE_LIMIT_MAX=120
PATINA_API_RATE_LIMIT_WINDOW_MS=60000
# Set only if a browser origin must read this API directly.
# PATINA_API_CORS_ORIGIN=https://app.example
# Written into the servers block of /openapi.json.
# PATINA_API_PUBLIC_URL=https://patina.example

# -------------------------------------------------------------------- logs

# debug, info, warn, error or silent.
PATINA_LOG_LEVEL=info
